            "id": "c51af05e-d670-40e7-8c00-231309246d67",
            "data": {
              "type": "tm.Process",
              "name": "AI Agent",
              "description": "The AI agent processes customer requests using the LLM, invokes authorized internal REST APIs, retrieves information from the RAG pipeline, and uses MCP tools based on the authenticated user's permissions. ",
              "outOfScope": false,
              "isTrustBoundary": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": false,
              "privilegeLevel": "Medium",
              "threats": [
                {
                  "id": "1b3292b2-f126-422f-b057-68f67d99f134",
                  "title": "AI Agent Identity Spoofing",
                  "status": "Open",
                  "severity": "Critical",
                  "type": "Spoofing",
                  "description": "An attacker may impersonate the AI agent or forge its identity token to gain unauthorized access to internal APIs and privileged operations.",
                  "mitigation": "Use OAuth 2.0 client credentials with short-lived tokens, validate token issuer and audience, enforce least-privilege scopes, and use mutual TLS for service-to-service authentication.\n\n",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": "9"
                },
                {
                  "id": "f0e02958-6d3c-4ef6-b883-6d4461d95c14",
                  "title": "LLM API Key Exposure via Prompt Injection",
                  "status": "Open",
                  "severity": "Critical",
                  "type": "Information disclosure",
                  "description": "An attacker may use indirect prompt injection to trick the AI agent into revealing its LLM API key or other sensitive credentials.",
                  "mitigation": "Store API keys in a secure secrets manager, never expose credentials in prompts or model responses, redact secrets from logs, restrict secret access, and monitor suspicious data exfiltration attempts.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": "9"
                },
                {
                  "id": "ea61eb34-c89a-40dc-be1f-72ef00dec0a6",
                  "title": "Unauthorized Modification of AI Agent Requests",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "An attacker may modify AI agent requests, API parameters, or session data during transmission to manipulate agent behavior, alter user instructions, or gain unauthorized access to internal platform resources.",
                  "mitigation": "Use HTTPS/TLS for all communications, validate request integrity, enforce server-side input validation, verify token signatures and claims, and apply strict authorization checks before processing sensitive API requests.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 8,
                  "score": "8"
                },
                {
                  "id": "11fc358f-056d-475d-8530-9a8f73c291c3",
                  "title": "AI Agent Resource Exhaustion",
                  "status": "Open",
                  "severity": "High",
                  "type": "Denial of service",
                  "description": "An attacker may send excessive or repeated requests to the AI Agent, exhausting its compute resources, API quota, or processing capacity and preventing legitimate users from accessing the service.",
                  "mitigation": "Implement rate limiting, request throttling, concurrency limits, request timeouts, and resource quotas. Monitor abnormal traffic patterns and use circuit breakers to maintain service availability.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 14,
                  "score": "8"
                }
              ],
              "threatFrequency": {
                "spoofing": 1,
                "tampering": 1,
                "repudiation": 0,
                "informationDisclosure": 1,
                "denialOfService": 1,
                "elevationOfPrivilege": 0
              }
            }
