            "id": "3139123a-689a-4729-876b-d9bc98aea0db",
            "data": {
              "type": "tm.Actor",
              "name": "Human User",
              "description": "An external customer who interacts with the SecureNova AI platform through the customer service interface and authenticates using Auth0 Universal Login with MFA.",
              "isTrustBoundary": false,
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "providesAuthentication": false,
              "threats": [
                {
                  "id": "931ed9a8-1376-40f2-869a-6a2d94158d3c",
                  "title": "Human User Identity Spoofing",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "An Attacker may impersonate a legitimate user to gain unauthorized access to the AI platform.",
                  "mitigation": "Enforce Auth0 authentication with multi-factor authentication (MFA). Validate user identity using signed tokens, verify token issuer and audience, and apply short-lived access tokens with secure session management.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": "8"
                },
                {
                  "id": "ef718e5e-bfed-4c02-845c-6749f0280e45",
                  "title": "User Activity Log Repudiation",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Repudiation",
                  "description": "A user may deny performing an action on the SecureNova AI platform if user activities and requests are not properly recorded or monitored.",
                  "mitigation": "Maintain centralized, timestamped audit logs for user authentication, requests, and sensitive actions. Record user identity, session ID, source IP, and action details. Protect logs against unauthorized modification and regularly review them.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
                  "score": "6"
                }
              ],
              "threatFrequency": {
                "spoofing": 1,
                "repudiation": 1
              }
            }
